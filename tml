  <style>
    /* ===== Design tokens: change colors and fonts here ===== */
    :root {
      --black: #000000;
      --surface: #141414;
      --line: #2b2b2b;
      --ash: #a6a6a6;
      --white: #ffffff;
      --champagne: #cdb48e;
      --display: "Archivo", "Arial Narrow", Arial, sans-serif;
      --serif: "Newsreader", Georgia, "Times New Roman", serif;
      --wrap: 1240px;
      --header-h: 68px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
      scroll-padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    }
    body {
      margin: 0;
      background: var(--black);
      color: var(--white);
      font-family: var(--serif);
      font-size: 1.125rem;
      line-height: 1.65;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; }
    :focus-visible { outline: 2px solid var(--champagne); outline-offset: 3px; }
    .wrap { width: min(100% - 2.5rem, var(--wrap)); margin-inline: auto; }
    .visually-hidden {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap;
    }
    .skip-link {
      position: absolute; left: 1rem; top: -4rem; z-index: 100;
      background: var(--white); color: var(--black); padding: .6rem 1rem;
      font-family: var(--display); font-weight: 700; text-decoration: none;
    }
    .skip-link:focus { top: 1rem; }

    /* ===== Type ===== */
    h2, h3 { margin: 0; }
    .h2 {
      font-family: var(--display);
      font-weight: 800;
      font-stretch: 118%;
      text-transform: uppercase;
      font-size: clamp(2.1rem, 6vw, 4rem);
      line-height: .95;
      letter-spacing: -.01em;
      margin-bottom: 1.25rem;
    }
    .h3 {
      font-family: var(--display);
      font-weight: 800;
      font-stretch: 115%;
      text-transform: uppercase;
      font-size: clamp(1.25rem, 2.4vw, 1.6rem);
      line-height: 1.1;
    }
    .lede {
      color: var(--ash);
      font-size: clamp(1.125rem, 1.6vw, 1.3rem);
      max-width: 36em;
      margin: 0;
    }
    .muted { color: var(--ash); }

    /* ===== Buttons ===== */
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 52px; padding: .85rem 1.6rem;
      font-family: var(--display); font-weight: 700; font-stretch: 110%;
      font-size: .875rem; letter-spacing: .08em; text-transform: uppercase;
      text-decoration: none; text-align: center; line-height: 1.2;
      border: 1.5px solid var(--white); border-radius: 2px;
      transition: background-color .2s, color .2s, border-color .2s;
      cursor: pointer;
    }
    .btn-primary { background: var(--white); color: var(--black); }
    .btn-primary:hover { background: var(--champagne); border-color: var(--champagne); }
    .btn-outline { background: transparent; color: var(--white); }
    .btn-outline:hover { background: var(--white); color: var(--black); }
    .btn-dark { background: var(--black); color: var(--white); border-color: var(--black); }
    .btn-dark:hover { background: transparent; color: var(--black); }
    .btn-small { min-height: 42px; padding: .55rem 1.1rem; font-size: .8rem; }

    /* ===== Header ===== */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: rgba(0, 0, 0, .94);
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line);
      padding-top: env(safe-area-inset-top, 0px);
    }
    .header-inner {
      display: flex; align-items: center; justify-content: space-between;
      min-height: var(--header-h); gap: 1rem;
    }
    .brand {
      font-family: var(--display); font-weight: 800; font-stretch: 125%;
      text-transform: uppercase; text-decoration: none;
      font-size: 1rem; letter-spacing: .02em;
    }
    .menu-toggle {
      background: none; border: 1.5px solid var(--white); color: var(--white);
      font-family: var(--display); font-weight: 700; font-size: .8rem;
      letter-spacing: .08em; text-transform: uppercase;
      min-height: 42px; padding: .5rem 1rem; border-radius: 2px; cursor: pointer;
    }
    .site-nav { display: none; }
    .site-nav.is-open {
      display: block; position: absolute; top: 100%; left: 0; right: 0;
      background: var(--black); border-bottom: 1px solid var(--line);
      padding: .5rem 1.25rem 1.5rem;
    }
    .site-nav ul { list-style: none; margin: 0; padding: 0; }
    .site-nav li a {
      display: block; padding: .9rem 0; border-bottom: 1px solid var(--line);
      font-family: var(--display); font-weight: 600; font-size: 1rem; text-decoration: none;
    }
    .site-nav .btn { margin-top: 1.25rem; width: 100%; }
    @media (min-width: 980px) {
      .menu-toggle { display: none; }
      .site-nav, .site-nav.is-open {
        display: flex; align-items: center; gap: 2rem;
        position: static; padding: 0; border: 0; background: none;
      }
      .site-nav ul { display: flex; gap: 1.75rem; }
      .site-nav li a { padding: .25rem 0; border: 0; font-size: .95rem; color: var(--ash); }
      .site-nav li a:hover { color: var(--white); }
      .site-nav .btn { margin-top: 0; width: auto; }
    }

    /* ===== Sections ===== */
    .section { padding-block: clamp(4.5rem, 10vw, 8rem); border-bottom: 1px solid var(--line); }
    .section-head { max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }

    /* ===== Hero ===== */
    .hero { padding-block: clamp(2.5rem, 7vw, 5rem) clamp(4rem, 8vw, 6.5rem); border-bottom: 1px solid var(--line); }
    .hero-name {
      font-family: var(--display); font-weight: 900; font-stretch: 125%;
      text-transform: uppercase; letter-spacing: -.02em;
      font-size: clamp(2.6rem, 10.5vw, 9.5rem); line-height: .9; margin: 0;
    }
    .hero-name span { display: block; }
    .hero-creds {
      display: flex; align-items: center; gap: 1rem; margin: 1.5rem 0 0;
      font-family: var(--display); font-weight: 600; font-stretch: 110%;
      font-size: clamp(.85rem, 1.4vw, 1rem); letter-spacing: .14em;
      text-transform: uppercase; color: var(--champagne);
    }
    .hero-creds::before { content: ""; width: 3rem; height: 1px; background: var(--champagne); flex: none; }
    .hero-grid { display: grid; gap: 2.75rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
    .hero-headline {
      font-size: clamp(1.6rem, 3.2vw, 2.6rem); line-height: 1.2;
      max-width: 22ch; margin: 0 0 1.25rem;
    }
    .hero-sub { color: var(--ash); max-width: 34em; margin: 0 0 2rem; }
    .hero-ctas { display: flex; flex-wrap: wrap; gap: .85rem; }
    .hero-ctas .btn { flex: 1 1 12rem; }
    @media (min-width: 900px) {
      .hero-grid { grid-template-columns: 1.15fr .85fr; align-items: end; gap: 4rem; }
      .hero-ctas .btn { flex: 0 0 auto; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .hero-name span { animation: rise .9s cubic-bezier(.2, .7, .1, 1) both; }
      .hero-name span:nth-child(2) { animation-delay: .12s; }
      .hero-creds { animation: fade .8s .45s both; }
      @keyframes rise { from { transform: translateY(35%); opacity: 0; } to { transform: none; opacity: 1; } }
      @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    }

    /* ===== Photo placeholders (swap for <img> later) ===== */
    .photo {
      margin: 0; position: relative; overflow: hidden;
      background: linear-gradient(160deg, #1e1e1e, #070707);
      border: 1px solid var(--line);
      display: grid; place-items: center;
    }
    .photo img { width: 100%; height: 100%; object-fit: cover; }
    .photo-placeholder {
      font-family: var(--display); font-size: .85rem; color: #707070;
      text-align: center; padding: 1rem;
    }
    .photo-hero { aspect-ratio: 4 / 5; }
    .photo-product { aspect-ratio: 4 / 5; }
    .photo-about { aspect-ratio: 3 / 4; }
    @media (max-width: 899px) { .photo-hero { aspect-ratio: 1 / 1; } }

    /* ===== Approach ===== */
    .approach-grid { display: grid; gap: 3rem; }
    @media (min-width: 900px) { .approach-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
    .approach-text p { margin: 0 0 1.1rem; max-width: 34em; }
    .principles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .principles li { display: grid; gap: .35rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
    .principles strong {
      font-family: var(--display); font-weight: 800; font-stretch: 118%;
      text-transform: uppercase; font-size: 1.3rem; letter-spacing: .01em;
    }
    .principles span { color: var(--ash); }

    /* ===== Personal training price list ===== */
    .price-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .price-row {
      display: grid; gap: 1.1rem; align-items: center;
      padding: 1.75rem 1.25rem; border-bottom: 1px solid var(--line);
    }
    .price-row .save { color: var(--ash); margin: .35rem 0 0; font-size: 1rem; }
    .price {
      font-family: var(--display); font-weight: 800; font-stretch: 105%;
      font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1; display: block;
    }
    .price-note { font-size: .95rem; color: var(--ash); }
    .price-row .btn { width: 100%; }
    .badge {
      display: inline-block; margin-bottom: .6rem; padding: .3rem .65rem;
      background: var(--champagne); color: var(--black);
      font-family: var(--display); font-weight: 700; font-size: .75rem; letter-spacing: .06em;
    }
    .price-row.is-featured { background: var(--white); color: var(--black); border-bottom-color: var(--white); }
    .price-row.is-featured .save,
    .price-row.is-featured .price-note { color: #4a4a4a; }
    @media (min-width: 760px) {
      .price-row { grid-template-columns: 1.4fr 1fr auto; gap: 2rem; padding: 2rem 1.75rem; }
      .price-row .btn { width: auto; min-width: 11rem; }
    }
    .fine-print { color: var(--ash); font-size: 1rem; margin: 1.5rem 0 0; }
    .price-row .desc { color: var(--ash); margin: .5rem 0 0; font-size: 1rem; max-width: 34em; }
    .duration { display: block; margin-top: .3rem; font-family: var(--display); font-weight: 600; font-size: .9rem; color: var(--champagne); }
    .price-row.is-featured .desc { color: #4a4a4a; }
    .price-row.is-featured .duration { color: #7a6440; }
    @media (min-width: 760px) { .price-row { grid-template-columns: 1.8fr .8fr auto; } }

    /* Premium 60-minute upgrade: set apart from the standard list */
    .upgrade {
      display: grid; gap: 1.1rem; align-items: center;
      margin-top: 2.5rem; padding: 1.75rem 1.25rem;
      background: var(--surface); border: 1px solid var(--champagne);
    }
    .upgrade .desc { color: var(--ash); margin: .5rem 0 0; font-size: 1rem; max-width: 34em; }
    .upgrade .btn { width: 100%; }
    .badge-outline { background: transparent; color: var(--champagne); border: 1px solid var(--champagne); }
    @media (min-width: 760px) {
      .upgrade { grid-template-columns: 1.8fr .8fr auto; gap: 2rem; padding: 2rem 1.75rem; }
      .upgrade .btn { width: auto; min-width: 11rem; }
    }

    /* ===== Online coaching plans ===== */
    .plans { display: grid; gap: 1.5rem; }
    @media (min-width: 860px) { .plans { grid-template-columns: 1fr 1fr; } }
    .plan {
      display: flex; flex-direction: column; gap: 1.25rem;
      padding: clamp(1.75rem, 4vw, 2.75rem);
      background: var(--surface); border: 1px solid var(--line);
    }
    .plan-premium { border-color: var(--champagne); }
    .plan-price { margin: 0; display: flex; align-items: baseline; gap: .35rem; }
    .plan-price .per { font-family: var(--display); color: var(--ash); font-size: 1rem; }
    .plan-for { margin: 0; color: var(--ash); }
    .plan-for strong { color: var(--white); font-weight: 600; }
    .plan-includes { margin: 0; font-family: var(--display); font-weight: 700; font-size: .95rem; }
    .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
    .checks li { position: relative; padding-left: 1.6rem; }
    .checks li::before {
      content: ""; position: absolute; left: 0; top: .82em;
      width: .85rem; height: 1px; background: var(--champagne);
    }
    .plan .btn { margin-top: auto; }

    /* ===== Programs ===== */
    .product { display: grid; gap: 2.5rem; }
    @media (min-width: 900px) { .product { grid-template-columns: .9fr 1.1fr; gap: 4.5rem; align-items: center; } }
    .product-title {
      font-family: var(--display); font-weight: 900; font-stretch: 125%;
      text-transform: uppercase; letter-spacing: -.015em;
      font-size: clamp(2.4rem, 6.5vw, 5.25rem); line-height: .92; margin-bottom: 1.25rem;
    }
    .specs {
      display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 1.5rem;
      margin: 2rem 0; border-top: 1px solid var(--line);
    }
    .specs div { padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .specs div:last-child { grid-column: 1 / -1; }
    .specs dt { font-family: var(--display); font-size: .9rem; color: var(--ash); }
    .specs dd { margin: .15rem 0 0; font-family: var(--display); font-weight: 700; font-size: 1.15rem; }
    .product-buy { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.75rem; }
    .product-buy .btn { flex: 1 1 14rem; }
    @media (min-width: 900px) { .product-buy .btn { flex: 0 0 auto; } }

    /* ===== About ===== */
    .about-grid { display: grid; gap: 2.75rem; }
    @media (min-width: 900px) { .about-grid { grid-template-columns: .8fr 1.2fr; gap: 5rem; align-items: start; } }
    .about-text p { margin: 0 0 1.2rem; max-width: 34em; }
    .creds-list {
      list-style: none; margin: 2rem 0 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: .75rem;
    }
    .creds-list li {
      border: 1px solid var(--champagne); color: var(--champagne);
      padding: .5rem .9rem; font-family: var(--display); font-weight: 600; font-size: .95rem;
    }

    /* ===== Getting started steps (a real sequence) ===== */
    .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; counter-reset: step; }
    @media (min-width: 860px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
    .steps li { counter-increment: step; border-top: 1px solid var(--white); padding-top: 1.25rem; }
    .steps li::before {
      content: counter(step); display: block; margin-bottom: .75rem;
      font-family: var(--display); font-weight: 900; font-stretch: 125%;
      font-size: 2.5rem; line-height: 1; color: var(--champagne);
    }
    .steps h3 { margin-bottom: .4rem; }
    .steps p { margin: 0; color: var(--ash); }
    .steps-cta { margin-top: 2.75rem; }

    /* ===== FAQ ===== */
    .faq-group { max-width: 52rem; margin-bottom: 3rem; }
    .faq-group:last-child { margin-bottom: 0; }
    .faq-group-title {
      font-family: var(--display); font-weight: 700; font-size: 1rem;
      color: var(--champagne); margin-bottom: .75rem;
    }
    .faq { border-top: 1px solid var(--line); }
    .faq details { border-bottom: 1px solid var(--line); }
    .faq summary {
      list-style: none; cursor: pointer;
      display: flex; justify-content: space-between; align-items: baseline; gap: 1.5rem;
      padding: 1.35rem 0;
      font-family: var(--display); font-weight: 700; font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after {
      content: "+"; flex: none; font-weight: 400; font-size: 1.6rem; line-height: 1;
      color: var(--champagne); transition: transform .2s;
    }
    .faq details[open] summary::after { transform: rotate(45deg); }
    .faq .answer { padding: 0 0 1.5rem; color: var(--ash); max-width: 42rem; }
    .faq .answer p { margin: 0 0 .75rem; }
    .faq .answer p:last-child { margin-bottom: 0; }

    /* ===== Contact ===== */
    .contact-grid { display: grid; gap: 3rem; }
    @media (min-width: 900px) { .contact-grid { grid-template-columns: .9fr 1.1fr; gap: 5rem; } }
    .contact-info { margin: 2.25rem 0 0; border-top: 1px solid var(--line); }
    .contact-info div { padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .contact-info dt { font-family: var(--display); font-size: .9rem; color: var(--ash); }
    .contact-info dd { margin: .15rem 0 0; font-family: var(--display); font-weight: 600; }
    .form { display: grid; gap: 1.25rem; }
    .form-row { display: grid; gap: 1.25rem; }
    @media (min-width: 640px) { .form-row { grid-template-columns: 1fr 1fr; } }
    .field { display: grid; gap: .45rem; }
    .field label { font-family: var(--display); font-weight: 600; font-size: .95rem; }
    .field .optional { color: var(--ash); font-weight: 400; }
    .field input, .field select, .field textarea {
      width: 100%; min-height: 52px; padding: .8rem 1rem;
      background: var(--black); color: var(--white);
      border: 1px solid #4a4a4a; border-radius: 2px;
      font: inherit; font-size: 1rem;
    }
    .field textarea { min-height: 9rem; resize: vertical; }
    .field input:focus, .field select:focus, .field textarea:focus {
      outline: none; border-color: var(--champagne); box-shadow: 0 0 0 1px var(--champagne);
    }
    .hp { display: none; }
    .form-status { margin: 0; min-height: 1.6em; font-size: 1rem; color: var(--champagne); }

    /* ===== Footer ===== */
    .site-footer { padding-block: 3.5rem 2rem; }
    .footer-inner { display: grid; gap: 2.25rem; }
    @media (min-width: 860px) { .footer-inner { grid-template-columns: 1.2fr 1fr 1fr; } }
    .footer-creds { margin: .4rem 0 0; color: var(--champagne); font-family: var(--display); font-size: .9rem; letter-spacing: .08em; }
    .footer-links { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
    .footer-links a, .footer-social a { text-decoration: none; font-family: var(--display); color: var(--ash); }
    .footer-links a:hover, .footer-social a:hover { color: var(--white); }
